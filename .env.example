# Copy to .env and fill in. REQUIRED ones have no default.
# REQUIRED: token the frame API and Home Assistant use (at least 24 characters, e.g. openssl rand -hex 24)
FRAME_TOKEN=
# REQUIRED: Immich API key for the frame (read, tag, favorite and pick scopes)
IMMICH_FRAME_KEY=
# REQUIRED: Immich API key for the curator (tagging scopes)
IMMICH_CURATOR_KEY=
# Optional: view-only token for the /show slideshow page (at least 24 characters, differs from FRAME_TOKEN; empty = off; e.g. openssl rand -hex 24)
SLIDESHOW_TOKEN=
# Optional: Home Assistant long-lived token, only used to read zone.home (home coordinates) when config.yaml has ha.url instead of home.lat/lon
HA_TOKEN=
# Optional: time zone for the nightly backfill window (default UTC), e.g. Europe/Oslo
TZ=UTC
# Optional: pin the image tag (default latest), e.g. 0.1.0
FRAMECURATOR_VERSION=latest
